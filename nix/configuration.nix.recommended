# /etc/nixos/configuration.nix
# NixOS configuration adapted for Panacea (Hyprland + SDDM)



{ config, pkgs, ... }:

let
  panacea-sddm-theme = pkgs.stdenvNoCC.mkDerivation {
    pname = "panacea-sddm-theme";
    version = "1.0.0";
    src = /home/levandoski/Panacea/sddm/panacea;
    dontBuild = true;
    installPhase = ''
      mkdir -p $out/share/sddm/themes/panacea
      cp -r * $out/share/sddm/themes/panacea/
    '';
  };
in
{
  imports =
    [
      ./hardware-configuration.nix
      ./desktop-entries.nix
    ];

  # Bootloader (Systemd-boot)
  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;

  # Network with native iwd

  networking = {
    networkmanager.enable = false;
    wireless.enable = false;
    wireless.iwd.enable = true;
  };

  # Time Zone & Location


  time.timeZone = "America/Sao_Paulo";
  i18n.defaultLocale = "pt_BR.UTF-8";
  i18n.extraLocaleSettings = {
    LC_ADDRESS = "pt_BR.UTF-8";
    LC_IDENTIFICATION = "pt_BR.UTF-8";
    LC_MEASUREMENT = "pt_BR.UTF-8";
    LC_MONETARY = "pt_BR.UTF-8";
    LC_NAME = "pt_BR.UTF-8";
    LC_NUMERIC = "pt_BR.UTF-8";
    LC_PAPER = "pt_BR.UTF-8";
    LC_TELEPHONE = "pt_BR.UTF-8";
    LC_TIME = "pt_BR.UTF-8";
  };

  # Basic graphics server (required for SDDM/Wayland)


  services.xserver.enable = true;

  # Hyprland & Portal Wayland
  programs.hyprland = {
    enable = true;
    xwayland.enable = true;
  };

  xdg.portal = {
    enable = true;
    extraPortals = [ pkgs.xdg-desktop-portal-hyprland ];
  };

  # Display Manager: Panacea-themed SDDM (GNOME/GDM disabled)

  services.displayManager.sddm = {
    enable = true;
    wayland.enable = true;
    theme = "panacea";
    extraPackages = [
      panacea-sddm-theme
      pkgs.qt6.qtdeclarative
      pkgs.qt6.qtsvg
      pkgs.qt6.qtmultimedia
    ];
  };

  # Shared directory for SDDM wallpaper and accent color


  systemd.tmpfiles.rules = [
    "d /var/lib/panacea 0777 root root -"
  ];

  # PAM authentication for Swaylock (lock screen and password vault)


  security.pam.services.swaylock = {};

  # Layout do teclado
  services.xserver.xkb = {
    layout = "br";
    variant = "abnt2";
  };
  console.keyMap = "br-abnt2";

  # Printing (CUPS)


  services.printing.enable = true;

  # Audio PipeWire

  services.pulseaudio.enable = false;
  security.rtkit.enable = true;
  services.pipewire = {
    enable = true;
    alsa.enable = true;
    alsa.support32Bit = true;
    pulse.enable = true;
    wireplumber.enable = true;
  };

  # System Services for Panacea


  hardware.bluetooth.enable = true;
  services.power-profiles-daemon.enable = true;
  services.upower.enable = true;
  hardware.i2c.enable = true;

  # User Configuration


  users.users."levandoski" = {
    isNormalUser = true;
    description = "levandoski";
    extraGroups = [ "wheel" "i2c" ];
    shell = pkgs.fish;
    packages = with pkgs; [];
  };

  programs.fish.enable = true;

  # Fontes
  fonts.packages = with pkgs; [
    nerd-fonts.jetbrains-mono
    noto-fonts
    noto-fonts-color-emoji
    noto-fonts-cjk-sans
  ];

  # Navegador Firefox
  programs.firefox.enable = true;

  # Steam & Jogos
  programs.steam = {
    enable = true;
    remotePlay.openFirewall = true;
    dedicatedServer.openFirewall = true;
  };
  programs.gamemode.enable = true;

  # Allow proprietary packages


  nixpkgs.config.allowUnfree = true;

  # Pacotes do sistema
  environment.systemPackages = with pkgs; [
    # Core & Shell Panacea
    hyprland
    quickshell
    hyprpaper
    hyprsunset
    foot
    fish
    eza
    zoxide
    bat
    fastfetch
    yazi
    swaylock

    # Screenshot, Clipboard & Panacea Utilities


    wl-clipboard        # Provides wl-copy and wl-paste (essential for printscreen and clipboard)

    cliphist            # Clipboard History Manager (Super+V)


    grim                # Screenshot for Wayland (PrintScreen / Super+Shift+S)

    slurp               # Screen region selection


    python3             # Required for high-speed cropping (shotcrop.py)


    wtype               # Typing simulation


    wf-recorder         # Screen recording (Super+P)


    ffmpeg              # SDDM Video Handling and Blur


    brightnessctl       # Controle de brilho
    ddcutil             # Brilho de monitores externos (I2C)
    playerctl           # Controle de media (teclas multimedia)

    wireplumber         # Gerenciamento de audio PipeWire

    cava                # Visualizador de audio

    mpvpaper            # Video animated wallpapers


    bibata-cursors      # Tema de cursores Bibata
    papirus-icon-theme  # Tema de icons Papirus

    udisks2             # Gerenciamento de discos
    udiskie             # Automatic mounting of flash drives


    gvfs                # Sistema de arquivos virtual
    openssl
    xdg-utils
    glib
    upower

    # Qt6/QML Libraries (Essential for QuickShell and SDDM)

    qt6.qtmultimedia
    qt6.qtdeclarative
    qt6.qtsvg

    # User Applications


    discord
    spotify
    kitty
    git
    vscode
    modrinth-app
    steam-run
    pavucontrol
  ];

  # Environment session variables


  environment.sessionVariables = {
    LIBVA_DRIVER_NAME = "nvidia";
    __GLX_VENDOR_LIBRARY_NAME = "nvidia";
    GBM_BACKEND = "nvidia-drm";
    QML2_IMPORT_PATH = "/run/current-system/sw/lib/qt-6/qml";
  };

  programs.nix-ld.enable = true;
  programs.nix-ld.libraries = with pkgs; [];

  system.stateVersion = "26.05";

  # NVIDIA Driver & Hybrid/PRIME Configuration


  services.xserver.videoDrivers = [ "nvidia" ];

  hardware.nvidia = {
    modesetting.enable = true;
    powerManagement.enable = false;
    powerManagement.finegrained = false;
    open = false;
    nvidiaSettings = true;
    package = config.boot.kernelPackages.nvidiaPackages.stable;

    prime = {
      offload = {
        enable = true;
        enableOffloadCmd = true;
      };
      intelBusId = "PCI:0:2:0";
      nvidiaBusId = "PCI:1:0:0";
    };
  };

  hardware.graphics = {
    enable = true;
    enable32Bit = true;
  };
}
